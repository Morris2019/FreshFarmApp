<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="FreshFarmApp.Views.Userlogin"
    xmlns:viewmodels="clr-namespace:FreshFarmApp.ViewModels"
    Title="Login"
    BackgroundColor="#F8F8F8">

   
    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="25">
            <!-- Header -->
            <Label Text="Welcome Back!" 
                   FontSize="32" 
                   FontAttributes="Bold" 
                   TextColor="#4F3F9B"/>
            <Label Text="Log in to continue" 
                   FontSize="18" 
                   TextColor="#A3A3A4"/>

            <!-- Email Entry -->
            <Border BackgroundColor="#EFEFEF" Padding="10">
                <Entry Placeholder="Email"
                       Text="{Binding Email}"
                       IsPassword="False"
                       FontSize="16"/>
            </Border>

            <!-- Password Entry -->
            <Border BackgroundColor="#EFEFEF" Padding="10">
                <Entry Placeholder="Password"
                       Text="{Binding Password}"
                       IsPassword="True"
                       FontSize="16"/>
            </Border>

            <!-- Login Button -->
            <Button Text="Login"
                    Command="{Binding LoginCommand}"
                    BackgroundColor="#4F3F9B"
                    TextColor="White"
                    CornerRadius="10"
                    HeightRequest="55"/>

            <!-- Forgot Password -->
            <Label Text="Forgot your password?"
                   HorizontalOptions="Center"
                   TextColor="#4F3F9B"
                   FontAttributes="Bold"/>

            <!-- Divider -->
            <BoxView HeightRequest="1" Color="#DDD" Margin="0,20"/>

            <!-- Create Account -->
            <Button Text="Create your Account"
                    Command="{Binding CreateAccountCommand}"
                    BackgroundColor="White"
                    TextColor="#4F3F9B"
                    BorderColor="#4F3F9B"
                    BorderWidth="2"
                    CornerRadius="10"
                    HeightRequest="55"/>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
