<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="FreshFarmApp.Views.ProductDetailPage"
    Title="Product Details"
    BackgroundColor="White">

    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="12">

            <!-- Product Image -->
            <Image
                x:Name="ProductImage"
                HeightRequest="200"
                Aspect="AspectFill"
                BackgroundColor="#EEE"
                />

            <!-- Product Name -->
            <Label
                x:Name="ProductNameLabel"
                FontSize="24"
                FontAttributes="Bold"
                TextColor="#1F1F1F"/>

            <!-- Category -->
            <Label
                x:Name="ProductCategoryLabel"
                FontSize="16"
                TextColor="#6E6E6E"/>

            <!-- Price -->
            <Label
                x:Name="ProductPriceLabel"
                FontSize="20"
                FontAttributes="Bold"
                TextColor="#4F3F9B"/>

            <!-- Farmer -->
            <Label
                x:Name="ProductFarmerLabel"
                FontSize="14"
                TextColor="#9E9E9E"/>

            <!-- Description -->
            <Label
                x:Name="ProductDescriptionLabel"
                FontSize="16"
                TextColor="#333"
                LineBreakMode="WordWrap"/>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
