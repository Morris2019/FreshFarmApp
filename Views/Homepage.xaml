<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:models="clr-namespace:FreshFarmApp.Models"
    x:Class="FreshFarmApp.Views.Homepage"
    x:Name="ThisPage"
    BackgroundColor="#F8F9FB">

    <VerticalStackLayout Padding="16" Spacing="12">

        <!-- Search Bar -->
        <SearchBar
            Placeholder="Search by name, category, or farmer"
            Text="{Binding SearchText}"
            SearchCommand="{Binding LoadProductsCommand}"
            CancelButtonColor="#4F3F9B" />

        <!-- CollectionView -->
        <CollectionView
            ItemsSource="{Binding FilteredProducts}"
            Margin="0,8,0,0">

            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:FarmProduct">
                    <Frame
                        CornerRadius="20"
                        HasShadow="True"
                        BackgroundColor="White"
                        Margin="0,6,0,6"
                        Padding="12">

                        <!-- Tap Gesture -->
                        <Frame.GestureRecognizers>
                            <TapGestureRecognizer
                                Command="{Binding Source={x:Reference ThisPage}, Path=BindingContext.ProductTappedCommand}"
                                CommandParameter="{Binding .}" />
                        </Frame.GestureRecognizers>

                        <Grid ColumnDefinitions="100,*" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="12">

                            <!-- Product Image -->
                            <Image Source="{Binding ImagePath}"
                                   HeightRequest="100"
                                   WidthRequest="100"
                                   Aspect="AspectFill"
                                   Grid.RowSpan="3"/>

                            <!-- Product Name -->
                            <Label Text="{Binding Name}"
                                   FontSize="18"
                                   FontAttributes="Bold"
                                   TextColor="#1F1F1F"
                                   Grid.Column="1"
                                   Grid.Row="0" />

                            <!-- Category & Price -->
                            <Label Text="{Binding Category}"
                                   FontSize="14"
                                   TextColor="#6E6E6E"
                                   Grid.Column="1"
                                   Grid.Row="1" />

                            <Label Text="{Binding Price, StringFormat='₵ {0:F2}'}"
                                   FontSize="14"
                                   FontAttributes="Bold"
                                   TextColor="#4F3F9B"
                                   HorizontalOptions="End"
                                   Grid.Column="1"
                                   Grid.Row="1" />

                            <!-- Farmer -->
                            <Label Text="{Binding FarmerName}"
                                   FontSize="12"
                                   TextColor="#9E9E9E"
                                   Grid.Column="1"
                                   Grid.Row="2" />

                        </Grid>
                    </Frame>
                </DataTemplate>
            </CollectionView.ItemTemplate>

        </CollectionView>

    </VerticalStackLayout>
</ContentPage>
