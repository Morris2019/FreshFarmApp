<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="FreshFarmApp.Views.ProfilePage"
    x:Name="page" xmlns:viewmodels="clr-namespace:FreshFarmApp.ViewModels"
    x:DataType="viewmodels:ProfilePageViewModel">

    <Grid BackgroundColor="White">
        <Grid
            Margin="15,12"
            RowDefinitions="Auto,*"
            VerticalOptions="FillAndExpand">
            
            <StackLayout
                Grid.Row="0"
                Margin="0,30"
                Orientation="Horizontal">
                <Border
                    Background="Transparent"
                    StrokeShape="RoundRectangle 6"
                    StrokeThickness="0">
                    <Image
                        Aspect="AspectFit"
                        HeightRequest="120"
                        WidthRequest="120" 
                        Source="dotnet_bot.png"/> </Border>

                <StackLayout Margin="20" VerticalOptions="Center">
                    <Label
                        FontAttributes="Bold"
                        FontSize="26"
                        Text="{Binding FullName}"
                        TextColor="Black" />
                    <Label
                        FontSize="14"
                        Text="{Binding Email}"
                        TextColor="Black" />
                </StackLayout>
            </StackLayout>

            <CollectionView
                Grid.Row="1"
                IsVisible="{Binding IsLoaded}"
                ItemsSource="{Binding MenuItems}">
                <CollectionView.ItemsLayout>
                    <GridItemsLayout
                        Orientation="Vertical"
                        Span="1"
                        VerticalItemSpacing="12" />
                </CollectionView.ItemsLayout>

                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="viewmodels:ProfilePageViewModel+ProfileMenuItem">
                        <Grid Padding="5">
                           

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="40" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="40" />
                            </Grid.ColumnDefinitions>

                            <Border
                                Grid.Column="0"
                                HeightRequest="40"
                                StrokeShape="RoundRectangle 6"
                                StrokeThickness="0"
                                WidthRequest="36">
                                <Border.Background>
                                    <LinearGradientBrush EndPoint="0,1">
                                        <GradientStop Offset="0.1" Color="LightGreen" />
                                        <GradientStop Offset="1.0" Color="LightGray" />
                                    </LinearGradientBrush>
                                </Border.Background>
                                <Label
                                    FontFamily="MaterialIcon"
                                    FontSize="22"
                                    HorizontalOptions="Center"
                                    Text="{Binding Body}"
                                    TextColor="Black"
                                    VerticalOptions="Center" />
                            </Border>

                            <Label
                                Grid.Column="1"
                                Margin="18,0"
                                FontAttributes="Bold"
                                FontSize="16"
                                HorizontalOptions="Start"
                                Text="{Binding Title}"
                                TextColor="Black"
                                VerticalOptions="Center" />

                            <Label
                                Grid.Column="2"
                                FontAttributes="Bold"
                                FontFamily="MaterialIcon"
                                FontSize="16"
                                HorizontalOptions="End"
                                Text="&#xf142;"
                                TextColor="Black"
                                VerticalOptions="Center" />
                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </Grid>

       
    </Grid>
</ContentPage>